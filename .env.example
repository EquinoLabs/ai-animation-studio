# AI Animation Studio Environment Configuration Template
# Copy this file to .env to customize local development settings.

# Script generation provider: "ollama" (local LLM) or "mock" (offline deterministic double)
ANIM_LLM_SCRIPT_PROVIDER=ollama

# Ollama settings (used when ANIM_LLM_SCRIPT_PROVIDER=ollama)
ANIM_OLLAMA_MODEL=qwen2.5:7b
ANIM_OLLAMA_HOST=http://localhost:11434
ANIM_OLLAMA_TIMEOUT_SECONDS=60.0

# Video rendering settings
ANIM_FPS=24
ANIM_WIDTH=1080
ANIM_HEIGHT=1920
ANIM_ENCODER=auto

# Research tool settings (Phase 1)
# ANIM_TAVILY_API_KEY=tvly-...
# ANIM_FIRECRAWL_API_KEY=fc-...
ANIM_RESEARCH_MAX_SEARCH_CALLS=3
ANIM_RESEARCH_MAX_EXTRACT_CALLS=3
ANIM_RESEARCH_CALL_TIMEOUT_SECONDS=15.0
ANIM_RESEARCH_DEADLINE_SECONDS=60.0
ANIM_RESEARCH_MAX_PAGE_CHARS=15000
ANIM_RESEARCH_MAX_TOTAL_CHARS=45000
